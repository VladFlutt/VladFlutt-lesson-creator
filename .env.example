OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=

# Lesson video (YouTube Data API v3)
YOUTUBE_API_KEY=

# Comma-separated admin emails (the account must confirm its email first)
ADMIN_EMAILS=vladimir.sadikovv@gmail.com
