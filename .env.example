# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lesson text and news search
ANTHROPIC_API_KEY=
# Optional, defaults to claude-opus-5-5
ANTHROPIC_MODEL=

# Lesson image: OpenAI images (preferred), or Gemini. With neither key the
# closest character reference picture is shown instead.
OPENAI_API_KEY=
